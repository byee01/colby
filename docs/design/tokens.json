{
  "$schema": "colby-tokens/1",
  "theme": "dark",
  "color": {
    "window": "#000000",
    "card": "#161616",
    "raised": "#1f1f1f",
    "line": "#2c2c2c",
    "grid": "#2a2a2a",
    "text": "#f5f5f5",
    "text2": "#c7c7c7",
    "muted": "#9b9b9b",
    "disabled": "#6b6b6b",
    "targetLine": "#d9d9d9",
    "scrubLine": "#d9d9d9",
    "sensor": {
      "core": "#4ea1f7",
      "surface": "#ffb81c",
      "ambient": "#f5701f",
      "other": "#6b6b6b",
      "pillText": "#000000"
    },
    "status": {
      "ready": "#5fd17a",
      "critical": "#e5484d",
      "criticalBg": "#3a1214",
      "criticalText": "#ffd6d7",
      "warning": "#fab219",
      "warningBg": "#2a2414"
    },
    "brand": "#ffb81c",
    "badge": {
      "fill": "#2a2a2a",
      "text": "#f5f5f5",
      "ringYellow": "#e9c440",
      "ringGrey": "#a3a3a3"
    },
    "button": {
      "primaryBg": "#f5f5f5",
      "primaryText": "#000000",
      "secondaryBg": "#1f1f1f",
      "secondaryText": "#f5f5f5",
      "secondaryBorder": "#2c2c2c",
      "dangerText": "#ff9a9d",
      "dangerBorder": "#4a1f21"
    },
    "toggleOn": "#4ea1f7",
    "toggleOff": "#444444",
    "kitchenAlarmBg": "#a32020"
  },
  "font": {
    "text": { "family": "Barlow", "weights": [400, 500, 600, 700], "license": "SIL OFL 1.1" },
    "numeric": { "family": "Barlow Condensed", "weights": [500, 600], "features": ["tnum"], "license": "SIL OFL 1.1" }
  },
  "type": {
    "caption": { "font": "text", "size": 13, "weight": 400 },
    "body": { "font": "text", "size": 15, "weight": 400 },
    "label": { "font": "text", "size": 14, "weight": 600 },
    "title": { "font": "text", "size": 22, "weight": 700 },
    "header": { "font": "text", "size": 32, "weight": 700 },
    "axis": { "font": "numeric", "size": 16, "weight": 500 },
    "chipValue": { "font": "numeric", "size": 30, "weight": 500 },
    "readout": { "font": "numeric", "size": 72, "weight": 500 },
    "readoutHistory": { "font": "numeric", "size": 64, "weight": 500 },
    "countdown": { "font": "numeric", "size": 64, "weight": 600 },
    "secondaryTime": { "font": "numeric", "size": 22, "weight": 500, "color": "muted" },
    "kitchenCountdown": { "font": "numeric", "size": 116, "weight": 600, "scaleBy": { "8": 0.62, "4": 1.0 } },
    "kitchenCountdownSingle": { "font": "numeric", "size": 400, "weight": 600, "lineHeight": 0.88 },
    "kitchenSecondarySingle": { "font": "numeric", "size": 72, "weight": 500, "color": "muted" },
    "instantRead": { "font": "numeric", "size": 300, "weight": 500 },
    "instantReadKitchen": { "font": "numeric", "size": 460, "weight": 500 }
  },
  "space": [4, 8, 12, 16, 20, 24, 28, 40],
  "radius": { "control": 10, "chip": 16, "card": 28, "pill": 999 },
  "stroke": { "series": 3, "seriesAll8Other": 1.5, "grid": 1.5, "target": 1.5, "scrub": 2.5, "scrubDotRadius": 10, "scrubDotRing": 3, "badgeRing": 2 },
  "motion": { "alertPulseMs": 1200, "respectReduceMotion": true },
  "layout": {
    "minTarget": 44,
    "inspectorWidth": [300, 380],
    "chipMinWidth": 220,
    "graphUpdateMaxHz": 10
  }
}
