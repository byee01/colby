<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Combustion.Windows.Platform</RootNamespace>
    <AssemblyName>Combustion.Windows.Platform</AssemblyName>
    <Description>Windows alert adapters: alarm toasts, looping system sounds, keep-awake, widget snapshot path (docs/02 §9). Port of mac/Sources/CombustionMacPlatform.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Combustion.Core\Combustion.Core.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" PrivateAssets="all" />
    <!-- Same rules as Core: IClock for time, no ConfigureAwait(false). -->
    <AdditionalFiles Include="..\Combustion.Core\BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>
</Project>
